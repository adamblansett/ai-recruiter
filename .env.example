# AI Recruiter - Environment Configuration Template

# Application
APP_NAME="AI Recruiter"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-min-32-chars
ENCRYPTION_KEY=replace-with-a-valid-32-byte-base64-fernet-or-aes-key==

# API Configuration
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_recruiter
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_recruiter

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Provider Keys (Optional for initial boot, required for AI evaluations)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Google OAuth & Gmail API (Configured during outreach setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=5242880
